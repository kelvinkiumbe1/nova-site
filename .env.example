# API (Spring Boot)
DB_URL=jdbc:postgresql://localhost:5434/nova
DB_USER=nova
DB_PASSWORD=nova
PORT=8081
SITE_URL=http://localhost:5173
COOKIE_SECURE=false            # true in production (HTTPS)
ADMIN_EMAIL=                   # first admin, created only when no admins exist
ADMIN_PASSWORD=                # min 12 characters
QUOTE_NOTIFY_EMAIL=            # comma-separated recipients for new quote alerts
MAIL_FROM=no-reply@novasitecare.co.ke
MAIL_HOST=                     # e.g. smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
TURNSTILE_SECRET=              # Cloudflare Turnstile secret; empty disables bot check (dev only)

# Media storage
STORAGE_TYPE=local             # local (dev) | s3 (Cloudflare R2 in production)
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=                   # https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=            # public URL of the bucket, e.g. https://media.novasitecare.co.ke
