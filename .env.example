# API (Spring Boot)
DB_URL=jdbc:postgresql://localhost:5434/nova
DB_USER=nova
DB_PASSWORD=nova
PORT=8081
SITE_URL=http://localhost:5173
COOKIE_SECURE=false            # true in production (HTTPS)
ADMIN_EMAIL=                   # first admin, created only when no admins exist
ADMIN_PASSWORD=                # min 12 characters
QUOTE_NOTIFY_EMAIL=            # comma-separated recipients for new quote alerts
MAIL_FROM=no-reply@novasitecare.co.ke
MAIL_HOST=                     # e.g. smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
TURNSTILE_SECRET=              # Cloudflare Turnstile secret; empty disables bot check (dev only)
